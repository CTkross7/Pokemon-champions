{
  "name": "web",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --outfile=dist/_worker.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "node tests/smoke.mjs",
    "deploy": "npm run build && cd .. && npx wrangler deploy"
  },
  "dependencies": {
    "@pkmn/dex": "^0.10.11",
    "@smogon/calc": "^0.11.0",
    "@tailwindcss/vite": "^4.3.2",
    "i18next": "^26.3.6",
    "pretendard": "^1.3.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.110.0"
  }
}
